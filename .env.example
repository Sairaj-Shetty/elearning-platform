# Copy to .env if you want to override the Docker Compose defaults.
# Never commit a real .env file. Never put the Gemini key in the React app.

# Browser: http://localhost:3000
# Backend inside Docker uses the hostname "mongo", not localhost.
MONGODB_URI=mongodb://mongo:27017/lumina?replicaSet=rs0

# At least 32 characters. Replace this before any shared deployment.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Create a free key at https://aistudio.google.com/apikey
# Leave blank to run the platform without AI. AI screens will explain that the service is unavailable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Sample catalog and demo accounts are created only when this is true.
# Do not enable seeding in a production deployment.
SEED_ENABLED=true
SEED_PASSWORD=LuminaDev#2026

MEDIA_ROOT=/data/media
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=dev
